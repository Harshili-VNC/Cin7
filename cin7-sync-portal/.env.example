# Server Config
PORT=8080
NODE_ENV=development
APP_URL=http://localhost:8080

# Database Config (PostgreSQL for Prod, SQLite fallback for local dev)
DATABASE_URL=postgres://vnc_user:vnc_password@localhost:5432/vnc_cin7_portal
USE_SQLITE_DEV=true

# Security Keys
ENCRYPTION_KEY=vnc_secret_encryption_key_32bytes_len_!
SESSION_SECRET=vnc_cin7_portal_session_secret_2026_key

# Microsoft OAuth & Graph API Config
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_REDIRECT_URI=http://localhost:8080/api/auth/microsoft/callback

# Google OAuth & Drive/Sheets API Config
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Cin7 Core ERP Base URL
CIN7_BASE_URL=https://inventory.cin7.com/api/v1
