# Server Config
PORT=8080
NODE_ENV=development
APP_URL=http://localhost:8080

# ── Supabase (Production) ─────────────────────────────────────────────────────
# Get these from Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Direct DB connection (Session mode, port 5432) — from Dashboard → Settings → Database
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# ── Self-hosted PostgreSQL (alternative to Supabase) ─────────────────────────
# Only used if SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are NOT set
# DATABASE_URL=postgres://vnc_user:vnc_password@localhost:5432/vnc_cin7_portal

# ── Security Keys — REPLACE BOTH before any deployment ───────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_RANDOM_HEX_STRING
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_STRING

# Microsoft OAuth & Graph API Config
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_REDIRECT_URI=http://localhost:8080/api/auth/microsoft/callback

# Google OAuth & Drive/Sheets API Config
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Cin7 Core ERP Base URL
CIN7_BASE_URL=https://inventory.cin7.com/api/v1
